APP_NAME=AgriSage AI
ENVIRONMENT=development
# Optional locally. If omitted, the backend uses ./runtime/agrisage.db (SQLite).
# Set DATABASE_URL to Railway's PostgreSQL connection reference in production.
SEED_DATA=true

# Competition model: Qwen3 1.7B through Ollama. Risk remains deterministic.
MODEL_PROVIDER=ollama
MODEL_NAME=qwen3:1.7b
OLLAMA_BASE_URL=http://localhost:11434
MODEL_TIMEOUT_SECONDS=180

# For a hosted open-weight OpenAI-compatible endpoint, set MODEL_PROVIDER to
# openai_compatible and provide MODEL_BASE_URL, MODEL_NAME, and MODEL_API_KEY.
MODEL_API_KEY=

# The agent retrieves this public reference through the official Fetch MCP server.
EXTERNAL_EVIDENCE_URL=https://www.fao.org/policy-support/policy-themes/climate-smart-agriculture/Understanding-climate-smart-agriculture-/en

# Use exact production origins, comma separated, when deploying the backend.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
